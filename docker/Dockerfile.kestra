FROM kestra/kestra:latest

USER root

# Installer les dépendances Python dans le conteneur
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip && \
    pip install --break-system-packages --quiet pandas openpyxl duckdb requests python-dotenv slack-sdk && \
    rm -rf /var/lib/apt/lists/*

# Copier le code source
COPY src/ /app/src/
COPY input/ /app/input/
COPY main.py /app/main.py
COPY requirements.txt /app/requirements.txt

# Créer le dossier data
RUN mkdir -p /app/data && \
    id kestra 2>/dev/null && chown -R kestra:kestra /app || true

# Set PYTHONPATH
ENV PYTHONPATH=/app
ENV DUCKDB_PATH=/app/data/sports_poc.duckdb

USER root

WORKDIR /app
