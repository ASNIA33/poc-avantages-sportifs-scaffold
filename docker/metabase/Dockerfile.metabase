# =============================================================================
# Dockerfile — Metabase avec driver DuckDB
# Build multi-étapes :
#   1. Téléchargement du driver DuckDB (debian:12-slim)
#   2. Image finale Metabase avec driver installé dans /plugins/
#
# Driver : duckdb.metabase-driver.jar v1.5.1.0
# Source : https://github.com/motherduckdb/metabase_duckdb_driver
# =============================================================================

# --- Étape 1 : téléchargement du driver DuckDB ---
FROM debian:12-slim AS downloader

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG DUCKDB_DRIVER_VERSION=1.5.1.0
ARG DUCKDB_DRIVER_URL=https://github.com/motherduckdb/metabase_duckdb_driver/releases/download/${DUCKDB_DRIVER_VERSION}/duckdb.metabase-driver.jar

RUN curl -fsSL -o /duckdb.metabase-driver.jar "${DUCKDB_DRIVER_URL}"

# --- Étape 2 : image Metabase finale ---
FROM metabase/metabase:latest

# Copier le driver dans le répertoire des plugins Metabase
COPY --from=downloader /duckdb.metabase-driver.jar /plugins/duckdb.metabase-driver.jar

# Répertoire plugins déclaré (variable d'env pour Metabase)
ENV MB_PLUGINS_DIR=/plugins
