# ============================================================
# Configuration POC Avantages Sportifs
# Copier ce fichier en .env et renseigner les valeurs
# ============================================================

# --- Slack (OPTIONNEL) ---
# Sans webhook : mode dry-run, les messages sont générés dans les logs mais pas envoyés
# Pour obtenir un webhook : https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# --- Google Maps (OPTIONNEL) ---
# Sans clé : mode simulation avec calcul haversine (distances approximatives à vol d'oiseau)
# Pour obtenir une clé : Google Cloud Console → APIs & Services → Distance Matrix API
# Attention : payant après le free tier
GOOGLE_MAPS_API_KEY=

# --- Base de données ---
DUCKDB_PATH=data/sports_poc.duckdb

# --- Paramètres métier (modifiables pour la démo live) ---
PRIME_RATE=0.05
WELLBEING_THRESHOLD=15
WALK_MAX_DISTANCE_KM=15
BIKE_MAX_DISTANCE_KM=25
COMPANY_ADDRESS=1362 Avenue des Platanes, 34970 Lattes
